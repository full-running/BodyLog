{
  "env": {
    "browser": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "indent": ["error", 2, { "SwitchCase": 1 }],
    "strict": ["error", "global"],
    "no-var": "error",
    "no-unused-vars": "warn",
    "eqeqeq": "error",
    "no-console": "warn"
  }
}
